generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  USER
  TUTOR
  ADMIN
}

model User {
  id Int @default(autoincrement()) @id
  email String @unique
  password String
  name     String?
  bio     String?
  title   String?
  avatar  String?
  refreshToken String?
  roles Role[] @default([USER])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}